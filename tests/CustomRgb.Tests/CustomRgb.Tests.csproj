<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <DefineConstants Condition="Exists('../../app/USB/CustomRgbScene.cs')">$(DefineConstants);CUSTOM_IMPLEMENTED</DefineConstants>
    <DefineConstants Condition="Exists('../../app/USB/RgbPresets.cs')">$(DefineConstants);PRESETS_IMPLEMENTED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../app/USB/ModeLightingSettings.cs" Link="ModeLightingSettings.cs" />
    <Compile Include="../../app/USB/CustomRgbScene.cs" Link="CustomRgbScene.cs" Condition="Exists('../../app/USB/CustomRgbScene.cs')" />
    <Compile Include="../../app/USB/RgbPresets.cs" Link="RgbPresets.cs" Condition="Exists('../../app/USB/RgbPresets.cs')" />
  </ItemGroup>
</Project>
